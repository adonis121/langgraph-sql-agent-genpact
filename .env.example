OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: LangSmith tracing. Set to true only together with LANGSMITH_API_KEY,
# otherwise every run prints 401 errors (the local traces/ file is always written).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Optional: which database and notes file (defaults shown; relative paths are from the repo root)
DATABASE_URL=sqlite:///db/university.db
NOTES_PATH=config/university_notes.md
